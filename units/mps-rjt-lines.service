[Unit]
Description=MPS Ronin JT lines training sheet (Dino 5 Nov): every Ronin JT read, against its RoninStock capture (work/registers/ronin-jt-export.psv from the PC)
OnFailure=mps-alert@%n.service
[Service]
Type=oneshot
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ocr/pipeline
Nice=10
ExecStart=/usr/bin/python3 /srv/ocr/pipeline/rjt_lines_sheet.py --export /srv/ocr/scans/pipeline/work/registers/ronin-jt-export.psv
TimeoutStartSec=30m
