[Unit]
Description=MPS OCR pipeline dashboard (http://mps-frigate:8090)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dinoc
Group=dinoc
Environment=MPS_OCR_CONFIG=/srv/ocr/pipeline/config.json
ExecStart=/usr/bin/python3 /srv/ocr/pipeline/dashboard.py
Restart=always
RestartSec=5
UMask=0002

[Install]
WantedBy=multi-user.target
