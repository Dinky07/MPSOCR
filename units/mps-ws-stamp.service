[Unit]
Description=MPS workshop sheets: ISSUED FOR CONSTRUCTION stamp gate on new sheets (ws_stamp_pass.py --apply; black-and-white stamp = copy)
OnFailure=mps-alert@%n.service

[Service]
Type=oneshot
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ocr/pipeline
ExecStart=/usr/bin/python3 -u /srv/ocr/pipeline/ws_stamp_pass.py --apply
Nice=10
TimeoutStartSec=6h
