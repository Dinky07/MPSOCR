[Unit]
Description=MPS Ronin JT numbers model (Dino 5 Nov): fine-tune qty + stock code on the RoninStock capture; scored only, nothing live
OnFailure=mps-alert@%n.service
[Service]
Type=oneshot
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ocr/pipeline
ExecStart=/bin/bash /srv/ocr/pipeline/rjt_numbers_run.sh
TimeoutStartSec=7h
