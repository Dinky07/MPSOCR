[Unit]
Description=MPS routing rules: remove (MPS invoices, Sage sales orders, bank letters, Polymer supplier invoices, SAMPLE certs), sales quotes, Other Documents, C.O.D / cancelled tags (route_sort.py)
OnFailure=mps-alert@%n.service

[Service]
Type=oneshot
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ocr/pipeline
ExecStart=/usr/bin/python3 -u /srv/ocr/pipeline/route_sort.py --apply
Nice=10
TimeoutStartSec=8h
