[Unit]
Description=MPS numbers pass, one-off (Dino 2 Nov): the 1 Nov model over every unchecked order on the queue and hold without a spreadsheet row, including orders read by the older model
OnFailure=mps-alert@%n.service
[Service]
Type=oneshot
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ml/numbers
Environment=MPS_OCR_CONFIG=/srv/ocr/pipeline/config.json
ExecStart=/bin/bash /srv/ocr/pipeline/numbers_pass_run.sh 2026-11-02 --all-unchecked --redo-older
TimeoutStartSec=5h
Nice=5
