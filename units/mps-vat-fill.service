[Unit]
Description=MPS supplier VAT fill, then the Sage digit check (Dino 29 Oct): VAT numbers the reader missed, then invoice amounts / dates that differ from Sage only by a reading slip
[Service]
Type=oneshot
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ocr/pipeline
ExecStart=/usr/bin/python3 /srv/ocr/pipeline/vat_fill.py --apply --jobs 2
# 333: needs the VAT numbers filled above to find the invoice's Sage supplier
ExecStart=/usr/bin/python3 /srv/ocr/pipeline/sage_digits.py --apply
TimeoutStartSec=50min
