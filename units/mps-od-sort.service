[Unit]
Description=MPS Other Documents: OCR + rules (Saheti / Alenti / SARS) + summaries over the order and invoice queues -> review sheet (od_sort.py scan)
OnFailure=mps-alert@%n.service

[Service]
Type=simple
User=dinoc
Group=dinoc
WorkingDirectory=/srv/ocr/pipeline
ExecStart=/usr/bin/python3 -u /srv/ocr/pipeline/od_sort.py scan
Nice=10
RuntimeMaxSec=6h
